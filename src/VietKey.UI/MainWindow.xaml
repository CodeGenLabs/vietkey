<Window x:Class="VietKey.UI.DesktopSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietKey — Bảng điều khiển (Windows 11)"
        Width="680"
        Height="760"
        MinWidth="580"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F8"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13.5">

    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E5EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1B1B1F"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Background="#005FB8" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ModeBadgeBorder" Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#D92D20" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="ModeBadgeText" Text="V" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="VietKey cho Windows 11" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="StatusSubtitleText" Text="Bộ gõ Tiếng Việt nhẹ, mượt, không độ trễ — Đang bật Tiếng Việt (V)" Foreground="#E0EEFF" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="QuickToggleModeButton"
                        Grid.Column="2"
                        Content="Chuyển V / E"
                        VerticalAlignment="Center"
                        Padding="14,7"
                        Background="#FFFFFF"
                        Foreground="#005FB8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Scrollable Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Card 1: Input Method & Hotkey -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="1. Chế độ &amp; Kiểu gõ" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,12"/>

                        <CheckBox x:Name="VietnameseToggle"
                                  Content="Bật chế độ gõ Tiếng Việt (V)"
                                  FontWeight="Medium"
                                  Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kiểu gõ Tiếng Việt:" VerticalAlignment="Center" Foreground="#374151"/>
                            <ComboBox x:Name="InputMethodCombo" Grid.Column="1" Height="32" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Telex (s, f, r, x, j, w, aa, dd...)"/>
                                <ComboBoxItem Content="VNI (1, 2, 3, 4, 5, 6, 7, 8, 9)"/>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phím tắt chuyển Anh / Việt:" VerticalAlignment="Center" Foreground="#374151"/>
                            <ComboBox x:Name="HotkeyCombo" Grid.Column="1" Height="32" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Alt + Z"/>
                                <ComboBoxItem Content="Ctrl + Shift"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Smart Features & Compatibility -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="2. Chính tả, Đặt dấu &amp; Tương thích ứng dụng" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ModernToneToggle"
                                  Content="Đặt dấu kiểu mới (hoà, thuý thay vì hòa, thúy)"
                                  Margin="0,0,0,9"/>

                        <CheckBox x:Name="SpellCheckToggle"
                                  Content="Kiểm tra chính tả âm tiết Tiếng Việt"
                                  Margin="0,0,0,9"/>

                        <CheckBox x:Name="AutoRestoreEnglishToggle"
                                  Content="Tự động khôi phục từ Tiếng Anh khi gõ sai âm tiết (window, function, string...)"
                                  Margin="0,0,0,9"/>

                        <CheckBox x:Name="SmartSwitchToggle"
                                  Content="Tự nhớ trạng thái Anh/Việt riêng cho từng ứng dụng (Smart Switch)"
                                  Margin="0,0,0,9"/>

                        <CheckBox x:Name="BrowserFixToggle"
                                  Content="Sửa lỗi gợi ý tự động trên thanh địa chỉ Chrome, Edge, Google Search"
                                  Margin="0,0,0,9"/>

                        <CheckBox x:Name="StartupToggle"
                                  Content="Khởi động VietKey cùng Windows 11"
                                  Margin="0,0,0,2"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Macros -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Bảng gõ tắt (Macros)" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,10"/>

                        <CheckBox x:Name="MacrosToggle"
                                  Content="Cho phép mở rộng từ gõ tắt khi nhấn phím Cách (Space) hoặc dấu câu"
                                  Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MacroTriggerInput" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="6,0" ToolTip="Từ viết tắt (ví dụ: vn, ko)"/>
                            <TextBox x:Name="MacroExpansionInput" Grid.Column="2" Height="30" VerticalContentAlignment="Center" Padding="6,0" ToolTip="Cụm từ mở rộng (ví dụ: Việt Nam, không)"/>
                            <Button x:Name="AddMacroButton" Grid.Column="4" Content="Thêm / Sửa" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                            <Button x:Name="RemoveMacroButton" Grid.Column="6" Content="Xóa" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                        </Grid>

                        <ListBox x:Name="MacrosListBox" Height="92" BorderBrush="#D0D5DD" BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Live Typing Sandbox -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="4. Ô gõ thử nghiệm trực tiếp (Live Test)" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,6"/>
                        <TextBlock Text="Thử gõ trực tiếp bên dưới (ví dụ: tieengs vieetj, hoaf binhf, thuongwr, window):" Foreground="#4B5563" FontSize="12.5" Margin="0,0,0,8"/>
                        <TextBox x:Name="LiveSandboxTextBox"
                                 Height="56"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Padding="8,6"
                                 FontSize="14"
                                 BorderBrush="#9CA3AF"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterStatusText"
                       Grid.Column="0"
                       Text="Sẵn sàng — Cấu hình lưu tại %AppData%\VietKey\config.json"
                       VerticalAlignment="Center"
                       Foreground="#4B5563"
                       FontSize="12"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="1"
                    Content="Áp dụng ngay"
                    Style="{StaticResource SecondaryButtonStyle}"/>

            <Button x:Name="SaveAndCloseButton"
                    Grid.Column="3"
                    Content="Lưu &amp; Đóng"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
