<Window x:Class="VietKey.UI.DesktopSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VietKey — Gõ tiếng Việt dễ dàng (Windows 11)"
        Icon="pack://application:,,,/Assets/app-logo.png"
        Width="680"
        Height="545"
        MinWidth="600"
        MinHeight="510"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F8"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13.5">

    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E5EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1B1B1F"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern Windows 11 Pill TabControl & TabItem Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#E4E8F0"
                                    CornerRadius="10"
                                    Padding="4"
                                    Margin="0,0,0,12">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabPillBorder"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="10,7"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabPillBorder" Property="Background" Value="#EEF1F6"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabPillBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0067C0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card with Official VietKey Logo Banner & Active V/E Icon -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE3F0" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cropped Official Logo + Slogan -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/logo-banner.png"
                       Height="62"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

                <!-- Current Active Mode Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitleText"
                               Text="Đang bật chế độ Tiếng Việt (V)"
                               Foreground="#0F172A"
                               FontSize="14.5"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusSubtitleText"
                               Text="Kiểu gõ: Telex — Nhẹ, mượt, không độ trễ"
                               Foreground="#475569"
                               FontSize="12.5"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Active V/E Minimalist Icon + Toggle Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2A1B2E"
                            CornerRadius="8"
                            Width="40"
                            Height="40"
                            Padding="7"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Image x:Name="ActiveModeIconImage"
                               Source="pack://application:,,,/Assets/icon-v.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <Button x:Name="QuickToggleModeButton"
                            Content="Chuyển V / E"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabbed Settings Content (No Vertical ScrollViewer) -->
        <TabControl x:Name="SettingsTabControl" Grid.Row="1">
            <!-- Tab 1: General & Startup -->
            <TabItem Header="Thiết lập chung">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Chế độ &amp; Kiểu gõ" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,12"/>

                            <CheckBox x:Name="VietnameseToggle"
                                      Content="Bật chế độ gõ Tiếng Việt (V)"
                                      FontWeight="Medium"
                                      Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kiểu gõ Tiếng Việt:" VerticalAlignment="Center" Foreground="#374151"/>
                                <ComboBox x:Name="InputMethodCombo" Grid.Column="1" Height="32" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Telex (s, f, r, x, j, w, aa, dd...)"/>
                                    <ComboBoxItem Content="VNI (1, 2, 3, 4, 5, 6, 7, 8, 9)"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phím tắt chuyển Anh / Việt:" VerticalAlignment="Center" Foreground="#374151"/>
                                <ComboBox x:Name="HotkeyCombo" Grid.Column="1" Height="32" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Alt + Z"/>
                                    <ComboBoxItem Content="Ctrl + Shift"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Khởi động cùng hệ thống" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,10"/>

                            <CheckBox x:Name="StartupToggle"
                                      Content="Khởi động cùng Windows"
                                      Margin="0,0,0,9"/>

                            <CheckBox x:Name="HideDialogOnStartupToggle"
                                      Content="Không hiển thị hộp thoại khi khởi động"
                                      Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Spelling & Smart Features -->
            <TabItem Header="Chính tả &amp; Thông minh">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Chính tả, Đặt dấu &amp; Tương thích ứng dụng" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ModernToneToggle"
                                  Content="Đặt dấu kiểu mới (hoà, thuý thay vì hòa, thúy)"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="SpellCheckToggle"
                                  Content="Kiểm tra chính tả âm tiết Tiếng Việt"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="AutoRestoreEnglishToggle"
                                  Content="Tự động khôi phục từ Tiếng Anh khi gõ sai âm tiết (window, function, string...)"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="SmartSwitchToggle"
                                  Content="Tự nhớ trạng thái Anh/Việt riêng cho từng ứng dụng (Smart Switch)"
                                  Margin="0,0,0,12"/>

                        <CheckBox x:Name="BrowserFixToggle"
                                  Content="Sửa lỗi gợi ý tự động trên thanh địa chỉ Chrome, Edge, Google Search"
                                  Margin="0"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Tab 3: Macros -->
            <TabItem Header="Bảng gõ tắt">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bảng gõ tắt (Macros)" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,10"/>

                        <CheckBox x:Name="MacrosToggle"
                                  Grid.Row="1"
                                  Content="Cho phép mở rộng từ gõ tắt khi nhấn phím Cách (Space) hoặc dấu câu"
                                  Margin="0,0,0,10"/>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MacroTriggerInput" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="6,0" ToolTip="Từ viết tắt (ví dụ: vn, đc)"/>
                            <TextBox x:Name="MacroExpansionInput" Grid.Column="2" Height="30" VerticalContentAlignment="Center" Padding="6,0" ToolTip="Cụm từ mở rộng (ví dụ: Việt Nam, được)"/>
                            <Button x:Name="AddMacroButton" Grid.Column="4" Content="Thêm / Sửa" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                            <Button x:Name="RemoveMacroButton" Grid.Column="6" Content="Xóa" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                        </Grid>

                        <ListBox x:Name="MacrosListBox" Grid.Row="3" BorderBrush="#D0D5DD" BorderThickness="1"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: Live Typing Sandbox -->
            <TabItem Header="Gõ thử nghiệm">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Ô gõ thử nghiệm trực tiếp (Live Test)" FontWeight="SemiBold" FontSize="15" Foreground="#111827" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Thử gõ trực tiếp bên dưới (ví dụ: tieengs vieetj, hoaf binhf, thuongwr, window):" Foreground="#4B5563" FontSize="12.5" Margin="0,0,0,10"/>
                        <TextBox x:Name="LiveSandboxTextBox"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 FontSize="14"
                                 BorderBrush="#9CA3AF"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterStatusText"
                       Grid.Column="0"
                       Text="Sẵn sàng — Cấu hình lưu tại %AppData%\VietKey\config.json"
                       VerticalAlignment="Center"
                       Foreground="#4B5563"
                       FontSize="12"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="1"
                    Content="Áp dụng ngay"
                    Style="{StaticResource SecondaryButtonStyle}"/>

            <Button x:Name="SaveAndCloseButton"
                    Grid.Column="3"
                    Content="Lưu &amp; Đóng"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
