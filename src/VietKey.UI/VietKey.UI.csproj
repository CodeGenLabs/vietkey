<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VietKey.Core\VietKey.Core.csproj" />
    <ProjectReference Include="..\VietKey.Engine\VietKey.Engine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>VietKey</AssemblyName>
    <RootNamespace>VietKey.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\app-logo.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\logo-banner.png" Link="Assets\logo-banner.png" />
    <Resource Include="..\..\assets\app-logo.png" Link="Assets\app-logo.png" />
    <Resource Include="..\..\assets\app-logo.ico" Link="Assets\app-logo.ico" />
    <Resource Include="..\..\assets\icon-v.png" Link="Assets\icon-v.png" />
    <Resource Include="..\..\assets\icon-e.png" Link="Assets\icon-e.png" />
    <Resource Include="..\..\assets\icon-v.ico" Link="Assets\icon-v.ico" />
    <Resource Include="..\..\assets\icon-e.ico" Link="Assets\icon-e.ico" />
  </ItemGroup>

</Project>
